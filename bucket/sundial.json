{
    "homepage": "https://github.com/Deide/Sundial",
    "description": "Automation based on sunrise and sunset for Windows 10+",
    "version": "1.0.0",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/Deide/Sundial/blob/master/LICENSE"
    },
    "depends": [
        "pwsh"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/Deide/Sundial/archive/refs/tags/v1.0.0.zip",
            "hash": "3ae90ca03252b827257a808c4bafd420cc17e2b0edcc72edd761172996a804ff",
            "extract_dir": "Sundial-1.0.0"
        }
    },
    "installer": {
        "script": [
            "pwsh.exe"
        ],
        "args": [
            "-ExecutionPolicy Bypass",
            "-NoProfile",
            "-NonInteractive",
            "-WindowStyle Hidden",
            "-File $dir/Install-SolarSwitch.ps1"
        ]
    },
    "uninstaller": {
        "script": [
            "pwsh.exe"
        ],
        "args": [
            "-ExecutionPolicy Bypass",
            "-NoProfile",
            "-NonInteractive",
            "-WindowStyle Hidden",
            "-File $dir/Uninstall-SolarSwitch.ps1"
        ]
    },
    "persist": [
        "data"
    ],
    "checkver": {
        "github": "https://github.com/Deide/Sundial"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Deide/Sundial/archive/refs/tags/v$version.zip",
                "extract_dir": "Sundial-$version"
            }
        }
    }
}
