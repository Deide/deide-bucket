    "checkver": {
        "url": "https://git.magicbean.dev/api/v1/repos/MagicBeanDev/LongshotLauncher/releases/latest",
        "jsonpath": {
            "version": "$.tag_name",
            "download": "$.assets[?(@.name =~ /LongshotLauncher-v[\\d.]+-windows-x64-portable\\.zip/i)].browser_download_url",
            "hash": "$.assets[?(@.name =~ /SHA256SUMS/i)].browser_download_url"
        },
        "regex": "v([\\d\\.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchDownload",
                "hash": {
                    "url": "$matchHash",
                    "regex": "sha256:([a-fA-F0-9]+) LongshotBuilder-v[\\d.]+-windows-x64\\.zip"
                }
            }
        }
    }
