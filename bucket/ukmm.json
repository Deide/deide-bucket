{
    "homepage": "https://nicenenerd.github.io/ukmm/",
    "version": "0.7.1",
    "description": "A mod manager for The Legend of Zelda: Breath of the Wild. Successor to BCML. ",
    "license": {
        "identifier": "GPL-3.0-only",
        "url": "https://github.com/NiceneNerd/ukmm/blob/master/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/NiceneNerd/ukmm/releases/download/v0.7.1/ukmm-v0.7.1-windows.zip",
            "hash": "56cbe547f066fc9d18f0c9a8a2423f2f3832c0842bad6fc522720e9c9a914754",
            "bin": [
                [
                    "ukmm.exe",
                    "ukmm",
                    "--portable"
                ]
            ],
            "shortcuts": [
                [
                    "ukmm.exe",
                    "Zelda BOTW Mod Manager",
                    "--portable"
                ]
            ]
        }
    },
    "persist": [
        "data",
        "config"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/NiceneNerd/ukmm/releases/latest",
        "jsonpath": {
            "version": "$.tag_name",
            "download": "$.assets[?(@.name.endsWith('msvc.zip'))].browser_download_url"
        },
        "regex": "v([\\d.-]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchDownload",
                "hash": {
                    "url": "$url.sha256"
                }
            }
        }
    }
}
